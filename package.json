{
  "name": "dungeon-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A deterministic roguelike that AI agents play over MCP, with a benchmark harness and a replay viewer.",
  "engines": { "node": ">=22.18" },
  "bin": { "dungeon-bench": "src/cli.ts" },
  "scripts": {
    "play": "node src/cli.ts play",
    "bench": "node src/cli.ts bench",
    "mcp": "node src/cli.ts mcp",
    "serve": "node src/cli.ts serve",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.2"
  }
}
