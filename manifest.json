{
  "manifest_version": 3,
  "name": "Recall",
  "version": "0.1.0",
  "description": "A private, searchable memory of everything you read on the web. Everything stays on your device.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "alarms"],
  "background": { "service_worker": "src/background.js", "scripts": ["src/background.js"], "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "Recall", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "css": ["src/content.css"], "run_at": "document_idle" }],
  "omnibox": { "keyword": "re" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+R" }, "description": "Open Recall" },
    "remember-selection": { "suggested_key": { "default": "Alt+Shift+H" }, "description": "Remember the selected text" }
  },
  "browser_specific_settings": {
    "gecko": { "id": "recall@recall-addon", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
